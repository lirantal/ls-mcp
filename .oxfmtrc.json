{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "useTabs": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "__tests__/__fixtures__"
  ]
}
