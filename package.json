{
  "name": "ls-mcp",
  "version": "1.15.3",
  "description": "list and detect MCP servers and configurations",
  "types": "dist/main.d.ts",
  "type": "module",
  "bin": {
    "ls-mcp": "./dist/bin/cli.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      },
      "default": "./dist/main.mjs"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "engines": {
    "npm": ">=11.10.0",
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "start": "npm run build && vpx ./src/bin/cli.ts",
    "build": "vp check --no-fmt --no-lint src && vp pack",
    "lint": "vp lint -c .oxlintrc.json .",
    "lint:fix": "vp lint -c .oxlintrc.json --fix",
    "lint:markdown": "npx --no-install markdownlint-cli -i '**/node_modules/**' -c .github/.markdownlint.yml '**/**.md'",
    "test": "vp test run --coverage",
    "test:watch": "vp test watch --coverage",
    "coverage:view": "open coverage/lcov-report/index.html",
    "version": "changeset version",
    "release": "changeset publish",
    "coverage:cli": "c8 --reports-dir coverage/c8 vpx ./src/bin/cli.ts",
    "setup:hooks": "vp hooks enable"
  },
  "author": {
    "name": "Liran Tal",
    "email": "liran.tal@gmail.com",
    "url": "https://github.com/lirantal"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "list mcp",
    "list mcp servers",
    "list mcp configuration",
    "mcp",
    "model context protocol",
    "admin mcp",
    "manage mcp"
  ],
  "homepage": "https://github.com/lirantal/ls-mcp",
  "bugs": {
    "url": "https://github.com/lirantal/ls-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/ls-mcp.git"
  },
  "dependencies": {
    "agent-files": "^1.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "c8": "^12.0.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-security": "^4.0.0",
    "markdownlint-cli": "0.50.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "~6.0.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "c8": {
    "exclude": [
      "dist/**",
      "coverage/**",
      "__tests__/**",
      "**/*.test.ts",
      "**/*.test.js"
    ],
    "include": [
      "src/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  },
  "packageManager": "npm@11.21.0"
}
